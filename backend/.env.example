# ZeroWatch backend — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env (only this .env.example file) — .gitignore covers .env.

# ─── Local LLM ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./zerowatch.db

# ─── External free APIs ──────────────────────────────────────────────────────
# NVD API key — optional, raises rate limit from 5/30s to 50/30s
NVD_API_KEY=

# VirusTotal — required for VT checks (free key at virustotal.com)
VIRUSTOTAL_API_KEY=

# Shodan — optional (free tier: 100 query credits)
SHODAN_API_KEY=

# ─── App settings ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# SSRF guard: set true ONLY when testing against local sandbox targets
# (OWASP Juice Shop, DVWA, etc.) — never in production
ALLOW_LOCALHOST_SCAN_TARGETS=false

# ─── Rate limiting (outbound API calls) ──────────────────────────────────────
NVD_RATE_LIMIT=5
NVD_RATE_WINDOW_SECONDS=30
VIRUSTOTAL_RATE_LIMIT=4
VIRUSTOTAL_RATE_WINDOW_SECONDS=60

# ─── Anomaly replay settings ──────────────────────────────────────────────────
# Seconds between replayed flows (lower = faster demo; 0.05 = 20 flows/sec)
REPLAY_DELAY_SECONDS=0.05
