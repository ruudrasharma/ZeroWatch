# ============================
# ZeroWatch — root .gitignore
# ============================

# ─── Python ───
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# ─── Virtual environments ───
venv/
.venv/
env/

# ─── Secrets — NEVER commit real .env files ───
.env
.env.local
backend/.env
frontend/.env.local

# ─── Database (local state) ───
*.db
*.sqlite
*.sqlite3

# ─── Model checkpoints ───
# Models are tracked in this repository for ease of setup.
# Ensure file sizes do not exceed GitHub's 100MB limit.
backend/models/checkpoints/*.h5

# ─── Data / exports ───
backend/data/raw/
backend/data/processed/
backend/data/exports/*.pdf

# ─── Node / frontend ───
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/

# ─── OS / editor ───
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Logs ───
*.log

# ─── Pytest / coverage ───
.pytest_cache/
htmlcov/
.coverage

# ─── Ruff / mypy cache ───
.ruff_cache/
.mypy_cache/

# ─── Jupyter checkpoints ───
.ipynb_checkpoints/

# MLflow store. Run ./run_experiments.sh to create mlflow.db locally; it is kept out of git
# because GitHub push protection flags random strings inside the binary as API keys.
mlruns/
mlflow.db

# Raw NSL-KDD downloads (data/nsl_kdd.csv is the committed, processed file)
data/KDD*.txt

# Live prediction logs (a sample is committed as logs/sample_predictions.jsonl)
logs/predictions.jsonl
logs/feedback.jsonl

# UNSW-NB15 (32 MB) is downloaded by cross_dataset.py
data/UNSW_NB15*.csv
logs/labelled.jsonl
logs/assets.json
